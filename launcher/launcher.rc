#include <windows.h>
1 ICON "app_icon.ico"
1 24 "launcher.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 3,0,0,0
 PRODUCTVERSION 3,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Pdf Rename"
      VALUE "ProductName", "Pdf Rename"
      VALUE "FileVersion", "3.0"
      VALUE "ProductVersion", "3.0"
      VALUE "OriginalFilename", "Pdf Rename.exe"
      VALUE "InternalName", "pdfrename"
      VALUE "LegalCopyright", "M3D Lab, Texas Tech University"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
